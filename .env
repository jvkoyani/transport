NODE_ENV=development
PORT=5000
JWT_SECRET=your-transport-app-secret-key-change-in-production-12345

# ========== OTP DELIVERY METHOD ==========
# Choose ONE of the following methods:

# Option 1: TWILIO SMS (Recommended for production)
# 1. Sign up at https://www.twilio.com (free trial includes $15 credit)
# 2. Get your Account SID and Auth Token from Dashboard
# 3. Get a phone number (e.g., +1234567890)
# 4. Uncomment and fill in the values below:

TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Option 2: EMAIL OTP (Alternative method)
# 1. Use Gmail or any SMTP provider
# 2. For Gmail: Use App Passwords (not regular password)
# 3. Uncomment and fill in the values below:

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password_16_chars

# ========== FRONTEND ==========
VITE_API_URL=http://localhost:5000/api
